{
  "schemaVersion": "1.0",
  "id": "lookup-member-balance",
  "name": "lookup_member_balance",
  "description": "Find a member by ID and return the displayed current savings balance.",
  "surface": {
    "kind": "web",
    "entrypoint": "/target",
    "vendor": "Local Legacy Core",
    "fingerprint": "legacy-core-v1"
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "sensitive": true,
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "savingsBalance",
      "type": "currency",
      "redaction": "none"
    }
  ],
  "success": {
    "text": "Member profile"
  },
  "steps": [
    {
      "id": "open",
      "kind": "navigate",
      "value": "/target",
      "risk": "safe"
    },
    {
      "id": "member-id",
      "kind": "fill",
      "target": {
        "strategy": "label",
        "value": "Member number",
        "fallback": [
          {
            "strategy": "css",
            "value": "input[name=\"memberId\"]"
          }
        ],
        "rationale": "Visible label survives the intentionally table-based legacy markup; name is a secondary fallback."
      },
      "parameter": "memberId",
      "risk": "safe"
    },
    {
      "id": "search",
      "kind": "click",
      "target": {
        "strategy": "role",
        "value": "button:Search",
        "fallback": [
          {
            "strategy": "text",
            "value": "Search member"
          }
        ],
        "rationale": "Accessible name is primary, rendered text is secondary."
      },
      "risk": "safe"
    },
    {
      "id": "profile",
      "kind": "assert",
      "expected": "Member profile",
      "risk": "safe"
    },
    {
      "id": "balance",
      "kind": "extract",
      "target": {
        "strategy": "css",
        "value": "#savings-balance",
        "fallback": [],
        "rationale": "The output is an application-owned, stable id; the preceding visible label gives a reviewer semantic context."
      },
      "output": "savingsBalance",
      "risk": "safe"
    }
  ],
  "status": "approved",
  "tenantOverrides": {}
}